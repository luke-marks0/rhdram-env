{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rowhammer-openenv.invalid/schemas/action.schema.json",
  "title": "RowHammer-OpenEnv CallToolAction",
  "description": "Logical JSON shape carried by OpenEnv CallToolAction.",
  "$defs": {
    "Address": {
      "title": "SimulatedAddress",
      "description": "A synthetic simulator address. Never a host physical or virtual address.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "space",
            "value"
          ],
          "properties": {
            "space": {
              "const": "logical"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "space",
            "channel"
          ],
          "properties": {
            "space": {
              "const": "dram"
            },
            "channel": {
              "type": "integer",
              "minimum": 0
            },
            "pseudochannel": {
              "type": "integer",
              "minimum": 0
            },
            "rank": {
              "type": "integer",
              "minimum": 0
            },
            "bank_group": {
              "type": "integer",
              "minimum": 0
            },
            "bank": {
              "type": "integer",
              "minimum": 0
            },
            "subarray": {
              "type": "integer",
              "minimum": 0
            },
            "row": {
              "type": "integer",
              "minimum": 0
            },
            "column": {
              "type": "integer",
              "minimum": 0
            },
            "device": {
              "type": "integer",
              "minimum": 0
            },
            "lane": {
              "type": "integer",
              "minimum": 0
            },
            "bit": {
              "type": "integer",
              "minimum": 0
            },
            "burst_offset": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "space",
            "value"
          ],
          "properties": {
            "space": {
              "const": "row_handle"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9._:-]+$"
            }
          }
        }
      ]
    },
    "Region": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "space",
            "start",
            "end"
          ],
          "properties": {
            "space": {
              "const": "logical"
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "space",
            "name"
          ],
          "properties": {
            "space": {
              "const": "named"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "space",
            "row"
          ],
          "properties": {
            "space": {
              "const": "dram_row"
            },
            "row": {
              "title": "SimulatedAddress",
              "description": "A synthetic simulator address. Never a host physical or virtual address.",
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "space",
                    "value"
                  ],
                  "properties": {
                    "space": {
                      "const": "logical"
                    },
                    "value": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "space",
                    "channel",
                    "rank",
                    "bank",
                    "row"
                  ],
                  "properties": {
                    "space": {
                      "const": "dram"
                    },
                    "channel": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "pseudochannel": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "rank": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "bank_group": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "bank": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "subarray": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "row": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "column": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "device": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "lane": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "bit": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "burst_offset": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "space",
                    "value"
                  ],
                  "properties": {
                    "space": {
                      "const": "row_handle"
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[A-Za-z0-9._:-]+$"
                    }
                  }
                }
              ]
            },
            "column_start": {
              "type": "integer",
              "minimum": 0
            },
            "column_end": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "Pattern": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "constant_byte"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "width_bits",
            "endianness"
          ],
          "properties": {
            "kind": {
              "const": "constant_word"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            },
            "width_bits": {
              "enum": [
                8,
                16,
                32,
                64
              ]
            },
            "endianness": {
              "enum": [
                "little",
                "big"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "checkerboard",
                "inverse_checkerboard"
              ]
            },
            "phase": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "period",
            "values"
          ],
          "properties": {
            "kind": {
              "enum": [
                "row_stripe",
                "column_stripe"
              ]
            },
            "period": {
              "type": "integer",
              "minimum": 1
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "seed"
          ],
          "properties": {
            "kind": {
              "const": "prng"
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "algorithm": {
              "enum": [
                "philox4x32-10",
                "threefry2x64-20"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "encoding",
            "data"
          ],
          "properties": {
            "kind": {
              "const": "explicit_bytes"
            },
            "encoding": {
              "enum": [
                "base64url",
                "hex"
              ]
            },
            "data": {
              "type": "string",
              "maxLength": 1398104
            }
          }
        }
      ]
    },
    "DescribeArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version"
      ],
      "properties": {
        "api_version": {
          "const": "rh-openenv/v1"
        }
      }
    },
    "GetTopologyArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version"
      ],
      "properties": {
        "api_version": {
          "const": "rh-openenv/v1"
        },
        "scope": {
          "type": [
            "string",
            "object",
            "null"
          ]
        },
        "include_mapping": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "InitializeMemoryArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "request_id",
        "region",
        "pattern",
        "mode"
      ],
      "properties": {
        "api_version": {
          "const": "rh-openenv/v1"
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 64
        },
        "region": {
          "$ref": "#/$defs/Region"
        },
        "pattern": {
          "$ref": "#/$defs/Pattern"
        },
        "mode": {
          "enum": [
            "simulated_writes",
            "instant_setup"
          ]
        }
      }
    },
    "WriteItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "encoding",
        "data"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/Address"
        },
        "encoding": {
          "enum": [
            "base64url",
            "hex"
          ]
        },
        "data": {
          "type": "string",
          "maxLength": 1398104
        },
        "mask": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1398104
        }
      }
    },
    "WriteMemoryArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "request_id",
        "writes"
      ],
      "properties": {
        "api_version": {
          "const": "rh-openenv/v1"
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 64
        },
        "writes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16384,
          "items": {
            "$ref": "#/$defs/WriteItem"
          }
        },
        "execution": {
          "$ref": "program.schema.json#/$defs/TransactionExecution"
        }
      }
    },
    "ReadItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "length"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/Address"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      }
    },
    "ReadMemoryArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "request_id",
        "reads",
        "return_mode"
      ],
      "properties": {
        "api_version": {
          "const": "rh-openenv/v1"
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 64
        },
        "reads": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16384,
          "items": {
            "$ref": "#/$defs/ReadItem"
          }
        },
        "return_mode": {
          "enum": [
            "bytes",
            "diff_from_initial",
            "aggregate"
          ]
        },
        "execution": {
          "$ref": "program.schema.json#/$defs/TransactionExecution"
        }
      }
    },
    "SubmitTransactionArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "request_id",
        "program",
        "execution"
      ],
      "properties": {
        "api_version": {
          "const": "rh-openenv/v1"
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 64
        },
        "program": {
          "$ref": "program.schema.json#/$defs/TransactionProgram"
        },
        "execution": {
          "$ref": "program.schema.json#/$defs/TransactionExecution"
        }
      }
    },
    "SubmitCommandArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "request_id",
        "program",
        "execution"
      ],
      "properties": {
        "api_version": {
          "const": "rh-openenv/v1"
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 64
        },
        "program": {
          "$ref": "program.schema.json#/$defs/CommandProgram"
        },
        "execution": {
          "$ref": "program.schema.json#/$defs/CommandExecution"
        }
      }
    },
    "GetTraceArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version"
      ],
      "properties": {
        "api_version": {
          "const": "rh-openenv/v1"
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "default": 256
        },
        "kinds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "enum": [
              "request",
              "issued_command",
              "request_completion",
              "refresh",
              "mitigation",
              "budget",
              "flip"
            ]
          }
        },
        "filters": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "ScriptLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "cpu_ms": {
          "type": "integer",
          "minimum": 1
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 1
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 16777216
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "processes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "file_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "RunScriptArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "request_id",
        "language",
        "source",
        "entrypoint",
        "args"
      ],
      "properties": {
        "api_version": {
          "const": "rh-openenv/v1"
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 64
        },
        "language": {
          "const": "python"
        },
        "source": {
          "type": "string",
          "maxLength": 131072
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "args": {
          "type": "object",
          "maxProperties": 256
        },
        "limits": {
          "$ref": "#/$defs/ScriptLimits"
        }
      }
    },
    "FinishArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "request_id",
        "verify"
      ],
      "properties": {
        "api_version": {
          "const": "rh-openenv/v1"
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 64
        },
        "verify": {
          "const": true
        }
      }
    },
    "GetStatusArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version"
      ],
      "properties": {
        "api_version": {
          "const": "rh-openenv/v1"
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "arguments"
      ],
      "properties": {
        "tool_name": {
          "const": "describe_environment"
        },
        "arguments": {
          "$ref": "#/$defs/DescribeArgs"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "arguments"
      ],
      "properties": {
        "tool_name": {
          "const": "get_topology"
        },
        "arguments": {
          "$ref": "#/$defs/GetTopologyArgs"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "arguments"
      ],
      "properties": {
        "tool_name": {
          "const": "initialize_memory"
        },
        "arguments": {
          "$ref": "#/$defs/InitializeMemoryArgs"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "arguments"
      ],
      "properties": {
        "tool_name": {
          "const": "write_memory"
        },
        "arguments": {
          "$ref": "#/$defs/WriteMemoryArgs"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "arguments"
      ],
      "properties": {
        "tool_name": {
          "const": "read_memory"
        },
        "arguments": {
          "$ref": "#/$defs/ReadMemoryArgs"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "arguments"
      ],
      "properties": {
        "tool_name": {
          "const": "submit_transactions"
        },
        "arguments": {
          "$ref": "#/$defs/SubmitTransactionArgs"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "arguments"
      ],
      "properties": {
        "tool_name": {
          "const": "submit_command_program"
        },
        "arguments": {
          "$ref": "#/$defs/SubmitCommandArgs"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "arguments"
      ],
      "properties": {
        "tool_name": {
          "const": "get_trace"
        },
        "arguments": {
          "$ref": "#/$defs/GetTraceArgs"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "arguments"
      ],
      "properties": {
        "tool_name": {
          "const": "run_script"
        },
        "arguments": {
          "$ref": "#/$defs/RunScriptArgs"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "arguments"
      ],
      "properties": {
        "tool_name": {
          "const": "finish_episode"
        },
        "arguments": {
          "$ref": "#/$defs/FinishArgs"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "arguments"
      ],
      "properties": {
        "tool_name": {
          "const": "get_status"
        },
        "arguments": {
          "$ref": "#/$defs/GetStatusArgs"
        }
      }
    }
  ]
}
