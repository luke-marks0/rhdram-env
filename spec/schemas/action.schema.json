{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rowhammer-openenv/action.schema.json",
  "title": "RowHammerEnv compact action envelope",
  "description": "Structural validation only. Tool-specific semantics are enforced by the environment contract tests.",
  "type": "object",
  "required": [
    "tool",
    "args"
  ],
  "additionalProperties": false,
  "properties": {
    "tool": {
      "type": "string",
      "enum": [
        "dram.info",
        "dram.read",
        "dram.write",
        "dram.issue",
        "script.run",
        "episode.finish"
      ]
    },
    "args": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "address": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "logical",
            "physical",
            "handle"
          ]
        },
        "addr": {
          "type": "integer",
          "minimum": 0
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "channel": {
          "type": "integer",
          "minimum": 0
        },
        "rank": {
          "type": "integer",
          "minimum": 0
        },
        "bankgroup": {
          "type": "integer",
          "minimum": 0
        },
        "bank": {
          "type": "integer",
          "minimum": 0
        },
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "command": {
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "ACT",
            "PRE",
            "RD",
            "WR",
            "REF",
            "RFM",
            "WAIT"
          ]
        },
        "addr": {
          "$ref": "#/$defs/address"
        },
        "cycles": {
          "type": "integer",
          "minimum": 0
        },
        "data_b64": {
          "type": "string"
        },
        "tag": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "common_arg_fields": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "addr": {
          "$ref": "#/$defs/address"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "data_b64": {
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          },
          "maxItems": 4096
        },
        "stop_on_error": {
          "type": "boolean"
        },
        "language": {
          "const": "python-rh-sdk"
        },
        "code": {
          "type": "string",
          "maxLength": 200000
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "reason": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
