{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rowhammer-openenv/observation.schema.json",
  "title": "RowHammerEnv observation envelope",
  "type": "object",
  "required": [
    "ok",
    "observation",
    "reward",
    "terminated",
    "truncated",
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "observation": {
      "type": "object",
      "required": [
        "episode_id",
        "task_id",
        "cycle",
        "budget_remaining"
      ],
      "additionalProperties": true,
      "properties": {
        "episode_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "task_family": {
          "type": "string"
        },
        "cycle": {
          "type": "integer",
          "minimum": 0
        },
        "objective": {
          "type": "object"
        },
        "capabilities": {
          "type": "object"
        },
        "disclosure": {
          "type": "object"
        },
        "target": {
          "type": "object"
        },
        "budget_remaining": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "last_action": {
          "type": "object"
        },
        "public_counters": {
          "type": "object"
        },
        "feedback": {
          "type": "object"
        }
      }
    },
    "reward": {
      "type": "number"
    },
    "terminated": {
      "type": "boolean"
    },
    "truncated": {
      "type": "boolean"
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
