{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rowhammer-openenv/task.schema.json",
  "title": "RowHammerEnv task config",
  "type": "object",
  "required": [
    "id",
    "profile",
    "standard",
    "mitigation",
    "disclosure",
    "objective",
    "budgets",
    "reward"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]+$"
    },
    "profile": {
      "type": "string"
    },
    "standard": {
      "type": "string",
      "enum": [
        "DDR3",
        "DDR4",
        "DDR5",
        "HBM2",
        "HBM3",
        "custom"
      ]
    },
    "mitigation": {
      "type": "object",
      "required": [
        "name",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "none",
            "oracle",
            "para",
            "twice",
            "graphene",
            "blockhammer",
            "hydra",
            "rrs",
            "aqua",
            "prac",
            "custom"
          ]
        },
        "params": {
          "type": "object"
        }
      }
    },
    "disclosure": {
      "type": "object",
      "required": [
        "mapping",
        "adjacency",
        "victim",
        "profile",
        "feedback"
      ],
      "additionalProperties": false,
      "properties": {
        "mapping": {
          "enum": [
            "physical",
            "logical_only",
            "opaque_handles"
          ]
        },
        "adjacency": {
          "enum": [
            "exact",
            "candidate_set",
            "hidden"
          ]
        },
        "victim": {
          "enum": [
            "exact",
            "row_handle",
            "cell_handle",
            "hidden_until_finish"
          ]
        },
        "profile": {
          "enum": [
            "public_profile_id",
            "family_only",
            "hidden"
          ]
        },
        "feedback": {
          "enum": [
            "full_trace",
            "summarized_counts",
            "reward_only"
          ]
        }
      }
    },
    "objective": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "enum": [
            "any_flip",
            "target_row_flip",
            "target_cell_flip",
            "pattern_target",
            "mitigation_aware"
          ]
        }
      }
    },
    "budgets": {
      "type": "object",
      "required": [
        "tool_calls",
        "acts",
        "cycles"
      ],
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "properties": {
        "tool_calls": {
          "type": "integer",
          "minimum": 1
        },
        "acts": {
          "type": "integer",
          "minimum": 1
        },
        "cycles": {
          "type": "integer",
          "minimum": 1
        },
        "script_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reward": {
      "enum": [
        "sparse_success",
        "training_cost_shaped"
      ]
    }
  }
}
